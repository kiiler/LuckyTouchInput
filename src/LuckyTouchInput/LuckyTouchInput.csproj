<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>LuckyTouchInput</AssemblyName>
    <RootNamespace>Lucky.TouchInput</RootNamespace>
    <StartupObject>Lucky.TouchInput.KeyboardHost</StartupObject>
    <Product>Lucky Touch Input</Product>
    <AssemblyTitle>Lucky Touch Input</AssemblyTitle>
    <Description>Adaptive touch input panel for Windows tablets and remote sessions.</Description>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Lucky Touch Input contributors</Authors>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
